# Safe default: no Minecraft network connections
MODE=mock
# live transport: mineflayer (legacy) or forge (headless Forge workers over localhost)
BBOT_TRANSPORT=mineflayer
# Forge worker bridge ports are FORGE_BRIDGE_BASE_PORT + bot index (3010.. for bot-1..)
FORGE_BRIDGE_BASE_PORT=3010
BOT_COUNT=10
SERVER_HOST=localhost
SERVER_PORT=25565
# Java Edition 1.8.9 is the first live-test target (not yet verified on server)
MC_VERSION=1.8.9
# Default accepts only system messages; use chat only after verifying the 1.8.9 channel
TRANSFER_MESSAGE_CHANNEL=system
ACCOUNTS_FILE=accounts.json
# In live API mode, accounts.json is optional; Web accounts persist under DATA_DIR.
DEBUG=false
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_BYTES=5000000
LOG_FILES=3
DATA_DIR=data
RECONNECT_BASE_MS=5000
RECONNECT_MAX_MS=120000
RECONNECT_JITTER_PERCENT=50
CONNECT_TIMEOUT_MS=60000
CONNECTION_SPACING_MS=3000
PLAY_COOLDOWN_MS=15000
JOIN_TIMEOUT_MS=30000
JOIN_MAX_ATTEMPTS=5
# BBot policy: 20 or fewer players are immediately requeued and never Pit-scanned.
# Set 0 to disable population gating.
PIT_EVENT_MIN_PLAYERS=21
# Re-check the current Pit tab-list population while the bot is idle.
PIT_POPULATION_CHECK_MS=10000
PATH_CONCURRENCY=2
PATH_TIMEOUT_MS=30000
TASK_TIMEOUT_MS=10000
EVENT_POLL_MS=10000
# Optional public JSON event feed. Live mode only. HTTPS required except localhost.
# Canonical payload: {"version":1,"events":[{"id":"...","instanceId":"mega...","type":"...","target":{"x":0,"y":64,"z":0},"expiresAt":1234567890000}]}
EVENT_PROVIDER_URL=
JOB_MAX_ATTEMPTS=3
JOB_RETRY_MS=5000
MAX_JOBS=2000
MAX_INSTANCES=1000
INSTANCE_SUSPECT_MS=300000
INSTANCE_INACTIVE_MS=1800000
# Coverage-first Pit distribution. When enabled, duplicate IN_PIT_IDLE bots
# reroll one at a time until each confirmed instance has at most one bot, or
# the bounded reroll budget is exhausted. Hypixel's verified lobby command is /l.
DISTRIBUTION_ENABLED=false
LOBBY_COMMAND=/l
REROLL_MAX_ATTEMPTS=3
REROLL_COOLDOWN_MS=60000

# Optional browser viewer for one selected live bot (testing only)
VIEWER_ENABLED=false
VIEWER_BOT_ID=bot-1
VIEWER_PORT=3007
VIEWER_VIEW_DISTANCE=4
VIEWER_FIRST_PERSON=true

# Management API. Keep API_PORT bound to localhost on OCI; expose only through the protected Cloudflare/reverse-proxy path.
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=3008
# Exact browser origin. On production use the Cloudflare-served BBot-Web origin.
API_ORIGIN=
# Public viewer base URL (no query string, credentials or secret path)
VIEWER_PUBLIC_URL=
