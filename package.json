{
  "name": "bbot",
  "version": "0.1.0",
  "description": "Windows-first client-side Minecraft bot manager",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "node dist/src/index.js",
    "start:mock": "node dist/src/index.js --mock",
    "test:soak": "npm run build && node dist/scripts/soak.js",
    "setup:live": "node scripts/setup-live-test.mjs",
    "setup:viewer": "node scripts/setup-viewer.mjs",
    "viewer:tunnel": "node scripts/viewer-tunnel.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ateeejh2/BBot.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ateeejh2/BBot/issues"
  },
  "homepage": "https://github.com/Ateeejh2/BBot#readme",
  "dependencies": {
    "dotenv": "17.4.2",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
